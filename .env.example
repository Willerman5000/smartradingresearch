# Motor: execution | risk | strategy | traders | validation
RESEARCH_ENGINE=execution

# Base CENTRAL del sistema principal: solo lectura de señales + escritura de hallazgos compactos.
CENTRAL_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
CENTRAL_SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY

# Base PRIVADA opcional del motor. Si se omite, usa la central para checkpoints/runs.
# Esto permite que cada motor tenga su propia BD más adelante sin cambiar código.
RESEARCH_SUPABASE_URL=
RESEARCH_SUPABASE_SERVICE_KEY=

# Protege /run. Usa el mismo secreto en GitHub Actions y Render.
RESEARCH_RUN_TOKEN=CHANGE_ME

# Seguridad de recursos
RESEARCH_MEMORY_HARD_MB=350
RESEARCH_MAX_SOURCE_ROWS=4000
RESEARCH_PAGE_SIZE=250
RESEARCH_WINDOW_DAYS=180
RESEARCH_FINDING_LIMIT=120

# Auto-run cuando el servicio está despierto. GitHub Actions también puede despertarlo.
RESEARCH_AUTO_RUN=1
RESEARCH_AUTO_INTERVAL_MINUTES=180
RESEARCH_BOOT_DELAY_SECONDS=45

# El bridge productivo NO existe aquí: los motores son research-only.
RESEARCH_AUTHORITY=RESEARCH_ONLY

RESEARCH_DASHBOARD_MAX_ROWS=120

# RF V1.3 — promoción a Shadow exige cobertura de economía neta.
RESEARCH_MIN_NET_EVIDENCE_PCT=80
RESEARCH_WALK_FORWARD_FOLDS=3

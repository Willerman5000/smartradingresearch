# Motor: execution | risk | strategy | traders | validation
RESEARCH_ENGINE=execution

CENTRAL_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
CENTRAL_SUPABASE_SERVICE_KEY=YOUR_SERVICE_ROLE_KEY
RESEARCH_SUPABASE_URL=
RESEARCH_SUPABASE_SERVICE_KEY=
RESEARCH_RUN_TOKEN=CHANGE_ME

# Recursos. Commit I usa más RAM de los Render Research sin acercarse a 512 MB.
RESEARCH_MEMORY_HARD_MB=430
RESEARCH_CAUSAL_MEMORY_TARGET_MB=390
RESEARCH_MAX_SOURCE_ROWS=5000
RESEARCH_PAGE_SIZE=400
RESEARCH_WINDOW_DAYS=180
RESEARCH_FINDING_LIMIT=180
RESEARCH_DASHBOARD_MAX_ROWS=180

RESEARCH_AUTO_RUN=1
RESEARCH_AUTO_INTERVAL_MINUTES=180
RESEARCH_BOOT_DELAY_SECONDS=45
RESEARCH_AUTHORITY=RESEARCH_ONLY

RESEARCH_MIN_NET_EVIDENCE_PCT=80
RESEARCH_WALK_FORWARD_FOLDS=3

# Commit G — Factory continuo, ahora balanceado por mercado/TF.
RESEARCH_FACTORY_MAX_CANDIDATES=48
RESEARCH_FACTORY_MIN_SOURCE_ROWS=6

# Commit I — replay causal distribuido entre los 4 motores analíticos.
RESEARCH_CAUSAL_ENABLED=1
RESEARCH_CAUSAL_MAX_BARS=9000
RESEARCH_CAUSAL_CACHE_MB=240
RESEARCH_CAUSAL_HTTP_PAUSE_MS=80
RESEARCH_CAUSAL_REFINE_SEEDS=4
RESEARCH_CAUSAL_MAX_REFINED_PER_CELL=84
RESEARCH_CAUSAL_FINALISTS_PER_CELL=4

# Costes conservadores modelados en el backtest (basis points).
RESEARCH_CAUSAL_SPOT_ROUNDTRIP_BPS=20
RESEARCH_CAUSAL_SPOT_SLIPPAGE_BPS=4
RESEARCH_CAUSAL_FUTURES_ROUNDTRIP_BPS=12
RESEARCH_CAUSAL_FUTURES_SLIPPAGE_BPS=6
RESEARCH_CAUSAL_FUNDING_STRESS_BPS_8H=1.0

# CEX flows: contexto actual, RESEARCH_ONLY. Nunca promueve sin histórico causal.
RESEARCH_EXCHANGE_FLOW_ENABLED=1

# Commit I.2 — 54/54 symbol×timeframe specialist convergence
RESEARCH_CAUSAL_FETCH_WORKERS=3
RESEARCH_CAUSAL_VALIDATION_RESCUE=0
RESEARCH_CAUSAL_VALIDATION_RESCUE_MAX_CELLS=0
RESEARCH_CAUSAL_REGISTRY_RETEST_LIMIT=16

# RC9.7.4 · Supabase Free-plan protection. Evidence engines cap at 2 MB/day;
# Validation may use up to 4 MB/day to classify the compact outputs of all lanes.
RESEARCH_FREE_PLAN_MODE=1
RESEARCH_EGRESS_DAILY_MB=4
SUPABASE_402_COOLDOWN_SECONDS=21600
